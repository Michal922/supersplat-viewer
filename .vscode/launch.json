{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        { //For npx serve (adjust port to what serve prints, often 3000):
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Chrome: public (serve)",
            "url": "https://localhost:3000/index.html",
            "webRoot": "${workspaceFolder}/public"
        },
        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Chrome against localhost (HTTPS)",
            "url": "https://localhost:3000",
            "webRoot": "${workspaceFolder}/public",
            "sourceMaps": true,
            "trace": true,
            "runtimeArgs": [
                "--ignore-certificate-errors", // since you're using self-signed cert
                "--unsafely-treat-insecure-origin-as-secure=https://localhost:3000"
            ]
        }
    ]
}
// cd public && npx serve; then attach debugger from vscode